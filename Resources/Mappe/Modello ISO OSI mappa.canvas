		{"id":"a3ad3d2bb710a517","type":"text","text":"Raffigurazione di come si chiamano i dati nei vari livelli","x":-300,"y":-100,"width":250,"height":70},
		{"id":"6b4d269e552ef4bf","type":"text","text":"## Livello teorico ","x":-1120,"y":-312,"width":718,"height":94},
